<!--
    S3-tiered storage for the history database (D-23, D-40, D-41).

    CH_S3_DISK_ENDPOINT is the bucket URL plus a key prefix ending in "/"
    (http://minio:9000/clickhouse-s3-disk/data/), the form of the S3-disk
    examples in clickhouse.com/docs/engines/table-engines/mergetree-family/
    mergetree ("…/my-bucket/root-path/"). Bug fixed 2026-09-30 (first live
    start): the double slash from clickhouse.com/docs/integrations/minio
    ("…/tables//") made 26.9.4.3 refuse to start with "Code: 36. Invalid S3
    key: '/' (http://minio:9000/clickhouse-s3-disk//)". Don't go back to it.

    Switching to AWS S3 later is a config change only (D-41): repoint
    CH_S3_DISK_ENDPOINT at the regional bucket URL and rotate S3_ACCESS_KEY /
    S3_SECRET_KEY. Nothing in this file, 01-schema.sql or 02-users.sh changes.

    endpoint/access_key_id/secret_access_key all use the from_env attribute
    (verified via ctx7, clickhouse/clickhouse-docs changelog/2018.md: "you can
    use the from_env attribute to set values in config files from environment
    variables") so no credential or host ever lands in this tracked file.

    allow_remote_fs_zero_copy_replication is left at its default (off) — this
    is a single-node server, zero-copy replication has no effect here and D-40
    says explicitly not to turn it on.
-->
<clickhouse>
    <!-- Filesystem read cache for the s3 disk (14.2 D-01): the failure-prediction
         forecasts read metrics beyond the 31-day move to MinIO, and without a
         cache every such read is an S3 round trip. The cache lives inside the
         already mounted clickhouse_data volume, so it survives a full down/up.
         Disk `s3` and policy `s3_tiered` keep their names (a renamed volume disk
         can orphan parts already stored under `s3`), and no `type=cache` wrapper
         disk is used; the disk just gains cache_name below.
         Source: oneuptime.com 2026-03-31 filesystem-cache article for the
         `filesystem_caches` / `cache_name` keys; the cache is listed in
         system.filesystem_cache_settings (clickhouse.com/docs/reference/
         system-tables/filesystem_cache_settings).
         Confidence MEDIUM: prove it live after a full
         `podman compose down && podman compose up -d` with
           SELECT cache_name, path, max_size, current_size
           FROM system.filesystem_cache_settings
         Fallback: if ClickHouse refuses to start, remove the filesystem_caches
         element and the cache_name line, do a full down/up (never restart the
         clickhouse container alone) and report; the type=cache wrapper shape
         needs a parts check first. -->
    <filesystem_caches>
        <s3_cache>
            <path>/var/lib/clickhouse/filesystem_caches/s3_cache/</path>
            <max_size>2Gi</max_size>
        </s3_cache>
    </filesystem_caches>
    <storage_configuration>
        <disks>
            <s3>
                <type>s3</type>
                <endpoint from_env="CH_S3_DISK_ENDPOINT"/>
                <access_key_id from_env="S3_ACCESS_KEY"/>
                <secret_access_key from_env="S3_SECRET_KEY"/>
                <metadata_path>/var/lib/clickhouse/disks/s3/</metadata_path>
                <!-- Stops a startup race with the minio-init bucket-creation job
                     from crash-looping ClickHouse: no part is moved to the s3
                     volume for 31 days anyway (see 01-schema.sql TTL rules), so
                     skipping the read/write/list probe at startup costs nothing
                     here (skip_access_check verified via ctx7, ClickHouse
                     25.10 release notes). -->
                <skip_access_check>true</skip_access_check>
                <cache_name>s3_cache</cache_name>
            </s3>
        </disks>
        <policies>
            <s3_tiered>
                <volumes>
                    <default>
                        <disk>default</disk>
                    </default>
                    <s3>
                        <disk>s3</disk>
                    </s3>
                </volumes>
                <move_factor>0.2</move_factor>
            </s3_tiered>
        </policies>
    </storage_configuration>
</clickhouse>
