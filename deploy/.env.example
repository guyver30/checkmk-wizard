# Copy this file to deploy/.env and fill in the real value.
# deploy/.env is gitignored — the real secret must never be committed.
#
# The automation user's secret. Obtain it either by letting the wizard's
# Phase 1 bootstrap provision the user (bootstrap_automation_user() in
# src/checkmk_wizard/api.py), or by reading it off the running site:
#
#   podman exec checkmk cat /omd/sites/dmc/var/check_mk/web/automation/automation.secret
#
# Note: cmkadmin's login password does NOT work here — it has no automation
# secret and cannot Bearer-auth the REST API (see api.py:360).
CMK_REST_SECRET=REPLACE_ME
