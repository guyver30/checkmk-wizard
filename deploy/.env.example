# Copy this file to deploy/.env and fill in the real value, or run
# deploy/init-env.sh, which generates every secret and asks for the rest.
# deploy/.env is gitignored — the real secret must never be committed.
#
# The automation user's secret. Pick a long random value up front:
#
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# The same value is shared by the worker (wizard, provisioning/probe scripts)
# and the poller. The wizard's Phase 1 pushes it into Checkmk, creating the
# 'automation' user or updating its secret if it already exists. To change it
# later: edit this file, re-run the wizard's Phase 1, then recreate the
# poller and worker. Leave it empty to fall back to the wizard generating a
# random secret and printing it once (copy it here afterwards).
#
# Note: cmkadmin's login password does NOT work here — it has no automation
# secret and cannot Bearer-auth the REST API.
CMK_REST_SECRET=

# The dashboard's scoped topology_editor Checkmk credential (amended
# 2026-09-30, quick 260930-hpy — supersedes the earlier browser-bundled
# credential). Generate it the same way as CMK_REST_SECRET above:
#
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# It is read by the worker (the wizard creates or rotates the scoped
# topology_editor user to this exact value right after Phase 1) and by the
# dashboard's nginx (injected server-side as the Authorization header on
# the allow-listed /checkmk-api/ REST calls — never sent to the browser).
# Leave it empty to keep the dashboard's map-editing switch disabled. To
# change it later: edit this file, re-run the wizard (or
# scripts/provision_topology_editor.py), then recreate the stack
# (podman compose down && podman compose up -d).
TOPOLOGY_EDITOR_SECRET=

# Checkmk site name (optional, default 'dmc'). Compose creates the site under
# this name on the FIRST start of the checkmk container (a fresh
# checkmk_data volume) and feeds the same value to the worker, poller and the
# wizard's site-name prompt. Set it BEFORE the first `podman compose up`;
# changing it afterwards does not rename an existing site (see
# docs/Podman setup ... §3 "Choosing the site name"). The dashboard also
# reads it (added 2026-09-30, quick 260930-ixs) -- it picks up a changed
# value at container start, no rebuild needed, via /config.json (see
# deploy/dashboard-nginx.conf, dashboard-react/src/lib/runtimeConfig.ts).
#
# The site id is also the MQTT namespace: every topic lives under
# `sites/<CMK_SITE_ID>/...`, and the mosquitto ACL is rendered from it at broker
# start (deploy/mosquitto.acl.template, deploy/render-mosquitto-acl.sh; an invalid
# id makes the broker container exit). It must be globally unique across every
# site that feeds one broker. Changing it (or `omd mv`) moves the namespace and
# leaves the old `sites/<old id>/...` subtree behind on the broker.
# CMK_SITE_ID=dmc

# The two Mosquitto broker passwords (quick 260930-jj4: moved out of the previously
# tracked broker credential file and its generator script into deploy/.env, the only
# per-machine file). REQUIRED -- compose refuses to start without them
# (`${MQTT_POLLER_PASSWORD:?}` / `${WS_PASSWORD:?}` in deploy/compose.yaml), and
# the mosquitto container builds its password file from them at every start
# (deploy/compose.yaml's mosquitto service entrypoint).
#
# MQTT_POLLER_PASSWORD: broker user `poller`, used by the mosquitto and poller
# services (the poller's authenticated write path on plain MQTT 1883).
#
# WS_PASSWORD: broker user `wsreader`, used by mosquitto and served to the
# browser by the dashboard via /config.json (dashboard-react/src/lib/
# runtimeConfig.ts) for the read-only broker login over WebSockets.
#
# Both are generated by deploy/init-env.sh. To rotate either: edit it here,
# then `podman compose down && podman compose up -d` -- retained messages in
# the mosquitto_data volume are unaffected by a password change. Allowed
# characters: no quotes, backslash, dollar sign, braces, semicolons or
# whitespace (both values are pasted verbatim into an nginx string literal
# and JSON in deploy/dashboard-nginx.conf).
MQTT_POLLER_PASSWORD=
WS_PASSWORD=

# ADMIN_WS_PASSWORD: broker user `wsadmin`, which may publish only on sites/<CMK_SITE_ID>/admin/cmd.
# Served to the browser by the dashboard's /admin-config.json for the admin mode
# (`?admin=1`). Open on the demo network. Generated by deploy/init-env.sh; same
# allowed characters as above. REQUIRED, like the two passwords above.
ADMIN_WS_PASSWORD=

# ADMIN_WS_USERNAME is optional (default wsadmin) and should be left alone unless
# you also change the user in deploy/mosquitto.acl.template and the mosquitto service's
# start-up command in deploy/compose.yaml.
# ADMIN_WS_USERNAME=wsadmin

# MQTT_ANALYTICS_PASSWORD: broker user `analytics`, used by the `analytics` container.
# Generated by deploy/init-env.sh; same allowed characters as above. REQUIRED.
MQTT_ANALYTICS_PASSWORD=

# TRIAGE_WS_PASSWORD: broker user `wstriage`, which may publish only on
# sites/<CMK_SITE_ID>/needs/triage/cmd. Served to the browser by the dashboard's
# /triage-config.json. Open on the demo network. Generated by deploy/init-env.sh. REQUIRED.
TRIAGE_WS_PASSWORD=
# TRIAGE_WS_USERNAME=wstriage

# WS_USERNAME is optional (default wsreader) and should be left alone unless
# you also change the user in deploy/mosquitto.acl.template and the mosquitto service's
# start-up command in deploy/compose.yaml.
# WS_USERNAME=wsreader

# Address of the machine running Podman, as your LAN hosts reach it (e.g.
# 192.168.1.20 or a DNS name). Set it BEFORE starting the stack: the wizard's
# Phase 5 shows it as the address Linux/Windows agents register against
# (cmk-agent-ctl register --server <this>:8000). Not the container's own
# 10.89.x.x address. To change it later: edit here, then
# `podman compose up -d worker`.
CMK_PUBLIC_HOST=

# --- Phase 14.1 history store: ClickHouse + Grafana secrets ---
#
# Generate each of the five values below up front with:
#
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# The URL-safe output also satisfies deploy/clickhouse-config/initdb/
# 02-users.sh's rule (no quotes, no backslash, no whitespace — those
# characters would break the SQL string literal the password is
# interpolated into). Set all five in this file BEFORE the first
# `podman compose up`: ClickHouse's init scripts run only on the first
# start of an empty clickhouse_data volume, so a value left empty at that
# point cannot be fixed later without deleting the volume (and its history).
#
# CH_ADMIN_PASSWORD: read by the `clickhouse` container. This is the
# ch_admin user's password — used by the init scripts and by an operator
# running `clickhouse client` by hand. Not used by the poller, dashboard or
# Grafana. Rotate by running, as ch_admin, `ALTER USER ch_admin IDENTIFIED
# WITH sha256_password BY '<new value>'`, then recreating the `clickhouse`
# container with the new value here (or start fresh with an empty
# clickhouse_data volume, which loses history).
CH_ADMIN_PASSWORD=
#
# CH_WRITER_PASSWORD: read by the `clickhouse` container (to create the
# user) and the `poller` container (to authenticate as it). This is the
# poller_writer user's password — the only ClickHouse identity that can
# INSERT into the history tables. Rotate the same way as CH_ADMIN_PASSWORD
# above (`ALTER USER poller_writer ...`), then recreate the poller
# container.
CH_WRITER_PASSWORD=
#
# CH_ANALYTICS_PASSWORD: password of the analytics_writer ClickHouse user, read
# by the `clickhouse` container (initdb creates the user on a fresh volume; on an
# existing volume apply migrations/14.2-analytics.sql) and the `analytics`
# container (to authenticate as it).
CH_ANALYTICS_PASSWORD=
#
# CH_READER_PASSWORD: read by the `clickhouse` container (to create the
# user) and the `dashboard` container's nginx, which injects it into the
# /ch-api/ proxy as the dashboard_reader identity (see
# deploy/dashboard-nginx.conf). This value never reaches the browser — only
# the nginx process holds it. Rotate via `ALTER USER dashboard_reader ...`,
# then recreate the `dashboard` container.
CH_READER_PASSWORD=
#
# CH_GRAFANA_PASSWORD: read by the `clickhouse` container (to create the
# user) and the `grafana` container's provisioned ClickHouse datasource
# (deploy/grafana-provisioning/datasources/clickhouse.yaml), which
# authenticates as the grafana_reader user. Rotate via `ALTER USER
# grafana_reader ...`, then recreate the `grafana` container.
CH_GRAFANA_PASSWORD=
#
# GRAFANA_ADMIN_PASSWORD: read by the `grafana` container as the Grafana
# admin login. Grafana refuses to start while this is empty or the literal
# default "admin" (HIST-10). Not a ClickHouse credential and not affected
# by the ALTER USER rotation steps above. Rotate by editing this file and
# recreating the `grafana` container; Grafana's own entrypoint re-applies
# GF_SECURITY_ADMIN_PASSWORD to the admin account on every start.
GRAFANA_ADMIN_PASSWORD=
