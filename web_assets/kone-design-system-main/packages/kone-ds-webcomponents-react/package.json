{
  "name": "@kone-ds/webcomponents-react",
  "sideEffects": false,
  "version": "1.1.0",
  "description": "React specific wrapper for component-library",
  "scripts": {
    "build": "npm run compile",
    "clean": "rm -rf dist",
    "compile": "npm run tsc",
    "tsc": "tsc -p .",
    "rollup": "rollup -c",
    "publish": "npm publish"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^12.0.3",
    "@semantic-release/npm": "^10.0.4",
    "@types/jest": "29.5.2",
    "@types/node": "^20.3.2",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "jest": "^29.5.0",
    "jest-dom": "^3.0.2",
    "np": "^8.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semantic-release": "^21.0.6",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@kone-ds/webcomponents": "^1.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "setupTestFrameworkScriptFile": "<rootDir>/jest.setup.js",
    "testPathIgnorePatterns": [
      "node_modules",
      "dist"
    ]
  }
}
