{
  "name": "@kone-ds/webcomponents",
  "version": "1.1.0",
  "description": "Kone standalone web components",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/kone-ds-webcomponents/kone-ds-webcomponents.esm.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.prod.devops.kiot.fi/kone-ux/kone-design-system.git"
  },
  "scripts": {
    "build": "stencil build && npm run build-storybook",
    "stencil": "stencil build --dev --watch --serve --open",
    "start": "npm run storybook",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "publish": "npm publish",
    "build:run": "npm run build && npm start"
  },
  "dependencies": {
    "@kone-ds/assets": "^1.1.0",
    "@kone-ds/fonts": "^1.1.0",
    "@kone-ds/tokens": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.5",
    "@babel/preset-env": "^7.24.4",
    "@babel/preset-typescript": "^7.24.1",
    "@stencil/angular-output-target": "^0.7.1",
    "@stencil/core": "^4.0.1",
    "@stencil/react-output-target": "^0.5.3",
    "@stencil/sass": "^3.0.4",
    "@storybook/addon-actions": "^7.0.24",
    "@storybook/addon-essentials": "^7.0.24",
    "@storybook/addon-interactions": "^7.0.24",
    "@storybook/addon-links": "^7.0.24",
    "@storybook/blocks": "^7.0.24",
    "@storybook/html": "^7.0.24",
    "@storybook/html-webpack5": "^7.0.24",
    "@storybook/testing-library": "^0.0.14-next.2",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.2",
    "babel-loader": "^9.1.2",
    "jest": "^29.5.0",
    "jest-cli": "^29.5.0",
    "puppeteer": "^19.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^7.0.24"
  },
  "license": "MIT"
}
